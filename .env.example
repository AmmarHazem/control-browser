# Service
PORT=8100
LOG_LEVEL=INFO
# Comma-separated. Empty means no authentication (development only).
API_KEYS=

# LLM used by Runs. Any OpenAI-compatible endpoint; callers may override per run.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# Optional web search. Without it the search tool is not registered.
SEARXNG_URL=

# Browser
BROWSER_HEADLESS=true
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=UTC
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=900
# Empty means the browser's own user agent, with the headless marker removed.
BROWSER_USER_AGENT=

# Sessions
MAX_SESSIONS=25
SESSION_IDLE_SECONDS=300
SESSION_MAX_LIFETIME_SECONDS=3600
ACTION_TIMEOUT_SECONDS=30
NAVIGATION_MIN_INTERVAL_SECONDS=1

# Budgets
SNAPSHOT_TOKEN_BUDGET=8000
TEXT_TOKEN_BUDGET=16000

# Runs
RUN_MAX_STEPS=50
RUN_TIMEOUT_SECONDS=600
CONFIRMATION_TIMEOUT_SECONDS=600
STUCK_FAILURE_THRESHOLD=2

# Safety. Comma-separated domain patterns no run may reach.
BLOCKED_DOMAINS=
ALLOW_PRIVATE_ADDRESSES=false

# Storage
DATA_DIR=data
SCREENSHOT_RETENTION_SECONDS=86400
SCREENSHOT_SWEEP_INTERVAL_SECONDS=3600
